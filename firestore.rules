rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTrustedReporter() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider is string &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasVerifiedSaudiPhone() {
      return isSignedIn() &&
        request.auth.token.phone_number is string &&
        request.auth.token.phone_number.matches('^\\+9665[0-9]{8}$');
    }

    function authOwnsPhone(phoneE164) {
      return hasVerifiedSaudiPhone() &&
        phoneE164 is string &&
        phoneE164 == request.auth.token.phone_number;
    }

    function candidateExists(candidateId) {
      return exists(/databases/$(database)/documents/candidates/$(candidateId));
    }

    function candidateData(candidateId) {
      return get(/databases/$(database)/documents/candidates/$(candidateId)).data;
    }

    function contactExists(candidateId) {
      return exists(/databases/$(database)/documents/candidateContacts/$(candidateId));
    }

    function contactData(candidateId) {
      return get(/databases/$(database)/documents/candidateContacts/$(candidateId)).data;
    }

    function ownerExists(candidateId) {
      return exists(/databases/$(database)/documents/candidateOwners/$(candidateId));
    }

    function ownerData(candidateId) {
      return get(/databases/$(database)/documents/candidateOwners/$(candidateId)).data;
    }

    function ownsCandidate(candidateId) {
      return isSignedIn() && ownerExists(candidateId) && ownerData(candidateId).userId == request.auth.uid;
    }

    function ownsCandidateAfter(candidateId) {
      return isSignedIn() &&
        existsAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)) &&
        getAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)).data.userId == request.auth.uid;
    }

    function verifiedPhoneOwnsCandidateContact(candidateId) {
      return hasVerifiedSaudiPhone() && ownerExists(candidateId) && authOwnsPhone(ownerData(candidateId).phoneE164);
    }

    function publicCandidateReadable(data) {
      return data.schemaVersion == 2 &&
        data.isHidden == false &&
        !data.keys().hasAny(['phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId']);
    }

    function publicContactReadable(candidateId, data) {
      return candidateExists(candidateId) &&
        candidateData(candidateId).schemaVersion == 2 &&
        candidateData(candidateId).isHidden == false &&
        candidateData(candidateId).allowContact == true &&
        data.schemaVersion == 3 &&
        !data.keys().hasAny(['userId', 'phoneE164']);
    }

    function validContactState(data, candidateId) {
      return data.schemaVersion == 3 &&
        data.candidateId == candidateId &&
        data.keys().hasOnly(['candidateId', 'phone', 'whatsapp', 'phoneVerified', 'schemaVersion', 'phoneClaimRevokedAt']) &&
        data.phone is string && data.phone.size() <= 30 &&
        data.whatsapp is string && data.whatsapp.size() <= 20 &&
        data.phoneVerified is bool &&
        (!data.keys().hasAny(['phoneClaimRevokedAt']) || data.phoneClaimRevokedAt is string);
    }

    function verifiedPublicStateMatchesContact(candidateId, data) {
      return data.phoneVerified == false ||
        (
          hasVerifiedSaudiPhone() &&
          existsAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)) &&
          getAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)).data.phoneVerified == true &&
          getAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)).data.phoneE164 == request.auth.token.phone_number &&
          getAfter(/databases/$(database)/documents/candidateOwners/$(candidateId)).data.userId == request.auth.uid
        );
    }

    function validCommunityJobApproval(jobId) {
      return isAdmin() &&
        incoming().keys().hasAll(['sourceType', 'sourceSubmissionId', 'approvedBy']) &&
        incoming().sourceType == 'community' &&
        incoming().sourceSubmissionId is string &&
        incoming().approvedBy == request.auth.uid &&
        exists(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)) &&
        get(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)).data.status == 'pending' &&
        existsAfter(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)) &&
        getAfter(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)).data.reviewedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/communitySubmissions/$(incoming().sourceSubmissionId)).data.publishedJobId == jobId;
    }

    function validFraudTarget(data) {
      return (
        data.targetType == 'general' && data.targetId == 'platform'
      ) || (
        data.targetType == 'job' && exists(/databases/$(database)/documents/jobs/$(data.targetId))
      ) || (
        data.targetType == 'candidate' && exists(/databases/$(database)/documents/candidates/$(data.targetId))
      );
    }

    function validFraudGuards(reportId, data) {
      return
        existsAfter(/databases/$(database)/documents/reportDedupe/$(request.auth.uid)/targets/$(data.targetType + '__' + data.targetId)) &&
        getAfter(/databases/$(database)/documents/reportDedupe/$(request.auth.uid)/targets/$(data.targetType + '__' + data.targetId)).data.reportId == reportId &&
        getAfter(/databases/$(database)/documents/reportDedupe/$(request.auth.uid)/targets/$(data.targetType + '__' + data.targetId)).data.usedAt == request.time &&
        existsAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)/slots/$(data.quotaSlot)) &&
        getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)/slots/$(data.quotaSlot)).data.reportId == reportId &&
        getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)/slots/$(data.quotaSlot)).data.usedAt == request.time;
    }

    function validJobCore(data) {
      return data.title is string &&
        data.title.size() > 0 && data.title.size() <= 150 &&
        data.company is string &&
        data.company.size() > 0 && data.company.size() <= 100 &&
        data.city is string && data.city.size() > 0 && data.city.size() <= 60 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 3000 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
        data.status is string &&
        (
          data.status == 'active' ||
          data.status == 'recently_confirmed' ||
          data.status == 'awaiting_confirmation' ||
          data.status == 'closed'
        );
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /fraudReports/{reportId} {
      allow create: if isValidId(reportId) &&
        isTrustedReporter() &&
        incoming().keys().hasAll([
          'targetType', 'targetId', 'targetTitle', 'reason', 'details',
          'reporterUid', 'quotaSlot', 'createdAt', 'createdAtServer', 'status'
        ]) &&
        incoming().keys().hasOnly([
          'targetType', 'targetId', 'targetTitle', 'reason', 'details',
          'reporterPhone', 'reporterUid', 'quotaSlot', 'createdAt',
          'createdAtServer', 'status'
        ]) &&
        incoming().reporterUid == request.auth.uid &&
        incoming().targetType is string &&
        (incoming().targetType == 'job' || incoming().targetType == 'candidate' || incoming().targetType == 'general') &&
        incoming().targetId is string && incoming().targetId.size() > 0 && incoming().targetId.size() <= 80 &&
        incoming().targetTitle is string && incoming().targetTitle.size() > 0 && incoming().targetTitle.size() <= 200 &&
        incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 100 &&
        incoming().details is string && incoming().details.size() > 0 && incoming().details.size() <= 2000 &&
        (!incoming().keys().hasAny(['reporterPhone']) || (incoming().reporterPhone is string && incoming().reporterPhone.size() <= 30)) &&
        incoming().quotaSlot is string && incoming().quotaSlot.matches('^[1-5]$') &&
        incoming().createdAt is string && incoming().createdAt.size() <= 50 &&
        incoming().createdAtServer == request.time &&
        incoming().status == 'pending' &&
        validFraudTarget(incoming()) &&
        validFraudGuards(reportId, incoming());

      allow get, list: if isAdmin();

      allow update: if isAdmin() &&
        existing().status == 'pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
        (incoming().status == 'reviewed' || incoming().status == 'dismissed') &&
        incoming().reviewedAt is string &&
        incoming().reviewedBy == request.auth.uid;

      allow delete: if false;
    }

    match /reportDedupe/{uid}/targets/{targetKey} {
      allow get: if isTrustedReporter() && request.auth.uid == uid;
      allow list: if false;

      allow create: if isTrustedReporter() &&
        request.auth.uid == uid &&
        targetKey == incoming().targetType + '__' + incoming().targetId &&
        incoming().keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'reportId', 'usedAt']) &&
        incoming().reporterUid == uid &&
        incoming().usedAt == request.time &&
        incoming().reportId is string &&
        existsAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)) &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.reporterUid == uid &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.targetType == incoming().targetType &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.targetId == incoming().targetId;

      allow update: if isTrustedReporter() &&
        request.auth.uid == uid &&
        existing().usedAt is timestamp &&
        request.time >= existing().usedAt + duration.value(24, 'h') &&
        targetKey == incoming().targetType + '__' + incoming().targetId &&
        incoming().keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'reportId', 'usedAt']) &&
        incoming().reporterUid == uid &&
        incoming().usedAt == request.time &&
        incoming().reportId is string &&
        existsAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)) &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.reporterUid == uid &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.targetType == incoming().targetType &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.targetId == incoming().targetId;

      allow delete: if false;
    }

    match /reportRateLimits/{uid}/slots/{slotId} {
      allow get: if isTrustedReporter() && request.auth.uid == uid && slotId.matches('^[1-5]$');
      allow list: if false;

      allow create: if isTrustedReporter() &&
        request.auth.uid == uid &&
        slotId.matches('^[1-5]$') &&
        incoming().keys().hasOnly(['uid', 'reportId', 'usedAt']) &&
        incoming().uid == uid &&
        incoming().reportId is string &&
        incoming().usedAt == request.time &&
        existsAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)) &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.reporterUid == uid &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.quotaSlot == slotId;

      allow update: if isTrustedReporter() &&
        request.auth.uid == uid &&
        slotId.matches('^[1-5]$') &&
        existing().usedAt is timestamp &&
        request.time >= existing().usedAt + duration.value(24, 'h') &&
        incoming().keys().hasOnly(['uid', 'reportId', 'usedAt']) &&
        incoming().uid == uid &&
        incoming().reportId is string &&
        incoming().usedAt == request.time &&
        existsAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)) &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.reporterUid == uid &&
        getAfter(/databases/$(database)/documents/fraudReports/$(incoming().reportId)).data.quotaSlot == slotId;

      allow delete: if false;
    }

    match /communitySubmissions/{submissionId} {
      allow create: if isValidId(submissionId) &&
        incoming().keys().hasAll([
          'title', 'companyOrShop', 'city', 'category',
          'contactNumber', 'details', 'status', 'submittedAt'
        ]) &&
        !incoming().keys().hasAny(['reviewedAt', 'reviewedBy', 'publishedJobId']) &&
        incoming().status == 'pending' &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150 &&
        incoming().companyOrShop is string && incoming().companyOrShop.size() > 0 && incoming().companyOrShop.size() <= 100 &&
        incoming().city is string && incoming().city.size() > 0 && incoming().city.size() <= 60 &&
        incoming().category is string && incoming().category.size() > 0 && incoming().category.size() <= 60 &&
        incoming().contactNumber is string && incoming().contactNumber.size() > 0 && incoming().contactNumber.size() <= 30 &&
        incoming().details is string && incoming().details.size() > 0 && incoming().details.size() <= 3000 &&
        incoming().submittedAt is string &&
        (!incoming().keys().hasAny(['salary']) || (incoming().salary is string && incoming().salary.size() <= 120)) &&
        (!incoming().keys().hasAny(['submitterName']) || (incoming().submitterName is string && incoming().submitterName.size() <= 100)) &&
        (!incoming().keys().hasAny(['submitterPhone']) || (incoming().submitterPhone is string && incoming().submitterPhone.size() <= 30));

      allow get, list: if isAdmin();

      allow update: if isAdmin() &&
        existing().status == 'pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'publishedJobId']) &&
        incoming().reviewedAt is string &&
        incoming().reviewedBy == request.auth.uid &&
        (
          (incoming().status == 'rejected' && !incoming().keys().hasAny(['publishedJobId'])) ||
          (
            incoming().status == 'approved' &&
            incoming().publishedJobId is string &&
            existsAfter(/databases/$(database)/documents/jobs/$(incoming().publishedJobId)) &&
            getAfter(/databases/$(database)/documents/jobs/$(incoming().publishedJobId)).data.sourceType == 'community' &&
            getAfter(/databases/$(database)/documents/jobs/$(incoming().publishedJobId)).data.sourceSubmissionId == submissionId &&
            getAfter(/databases/$(database)/documents/jobs/$(incoming().publishedJobId)).data.approvedBy == request.auth.uid
          )
        );

      allow delete: if false;
    }

    match /jobs/{jobId} {
      function ownsJob() {
        return isSignedIn() &&
          existing().keys().hasAll(['userId']) &&
          existing().userId == request.auth.uid;
      }

      function bumpReady() {
        return !existing().keys().hasAny(['lastBumpedAt']) ||
          (existing().lastBumpedAt is timestamp && request.time >= existing().lastBumpedAt + duration.value(24, 'h'));
      }

      function confirmReady() {
        return !existing().keys().hasAny(['lastConfirmedAtServer']) ||
          (existing().lastConfirmedAtServer is timestamp && request.time >= existing().lastConfirmedAtServer + duration.value(24, 'h'));
      }

      function ownerEdit() {
        return ownsJob() &&
          incoming().userId == existing().userId &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'company', 'city', 'category', 'salary', 'jobType',
            'sponsorshipTransfer', 'accommodationProvided', 'transportationProvided',
            'mealsProvided', 'overtimeAvailable', 'experienceYears', 'description',
            'requirements', 'phone', 'whatsapp', 'contactPerson', 'urgent',
            'urgentStartDate', 'urgentExpiresAt', 'updatedAt', 'updatedAtServer'
          ]) &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time &&
          validJobCore(incoming());
      }

      function ownerClose() {
        return ownsJob() &&
          existing().status != 'closed' &&
          incoming().status == 'closed' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'closedAt', 'updatedAt', 'updatedAtServer'
          ]) &&
          incoming().closedAt == request.time &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time;
      }

      function ownerReopen() {
        return ownsJob() &&
          existing().status == 'closed' &&
          incoming().status == 'active' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'reopenedAt', 'updatedAt', 'updatedAtServer'
          ]) &&
          incoming().reopenedAt == request.time &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time;
      }

      function ownerConfirm() {
        return ownsJob() &&
          existing().status != 'closed' &&
          confirmReady() &&
          incoming().status == 'recently_confirmed' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'lastConfirmedAt', 'lastConfirmedAtServer',
            'updatedAt', 'updatedAtServer'
          ]) &&
          incoming().lastConfirmedAt is string &&
          incoming().lastConfirmedAtServer == request.time &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time;
      }

      function ownerBump() {
        return ownsJob() &&
          existing().status != 'closed' &&
          bumpReady() &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastBumpedAt', 'activityAt', 'updatedAt', 'updatedAtServer'
          ]) &&
          incoming().lastBumpedAt == request.time &&
          incoming().activityAt == request.time &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time;
      }

      function ownerSanitizeLegacy() {
        return ownsJob() &&
          existing().keys().hasAny(['userEmail']) &&
          !incoming().keys().hasAny(['userEmail']) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['userEmail']);
      }

      allow get: if
        (existing().status != 'closed' && !existing().keys().hasAny(['userEmail'])) ||
        isAdmin() || ownsJob();

      allow list: if
        (existing().status != 'closed' && !existing().keys().hasAny(['userEmail'])) ||
        isAdmin() || ownsJob();

      allow create: if isValidId(jobId) &&
        validJobCore(incoming()) &&
        !incoming().keys().hasAny(['userEmail']) &&
        (
          validCommunityJobApproval(jobId) ||
          (
            isSignedIn() &&
            incoming().keys().hasAll([
              'userId', 'createdAt', 'createdAtServer', 'activityAt',
              'lastBumpedAt', 'lastConfirmedAt', 'lastConfirmedAtServer'
            ]) &&
            incoming().userId == request.auth.uid &&
            (!incoming().keys().hasAny(['sourceType']) || incoming().sourceType == 'employer') &&
            incoming().status == 'recently_confirmed' &&
            incoming().createdAt is string &&
            incoming().createdAtServer == request.time &&
            incoming().activityAt == request.time &&
            incoming().lastBumpedAt == request.time &&
            incoming().lastConfirmedAt is string &&
            incoming().lastConfirmedAtServer == request.time
          )
        );

      allow update: if isValidId(jobId) &&
        (isAdmin() || ownerEdit() || ownerClose() || ownerReopen() || ownerConfirm() || ownerBump() || ownerSanitizeLegacy());

      allow delete: if isAdmin();
    }

    // Actual Applications: deterministic one application per job + applicant UID.
    match /applications/{applicationId} {
      function applicationJobExists(data) {
        return exists(/databases/$(database)/documents/jobs/$(data.jobId));
      }

      function applicationJob(data) {
        return get(/databases/$(database)/documents/jobs/$(data.jobId)).data;
      }

      function applicantOwnsCandidate(data) {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/candidateOwners/$(data.candidateId)) &&
          get(/databases/$(database)/documents/candidateOwners/$(data.candidateId)).data.userId == request.auth.uid;
      }

      allow create: if isSignedIn() &&
        isValidId(applicationId) &&
        incoming().keys().hasOnly([
          'jobId', 'candidateId', 'applicantUid', 'employerUid',
          'status', 'createdAt', 'createdAtServer'
        ]) &&
        incoming().jobId is string &&
        incoming().candidateId is string &&
        incoming().applicantUid == request.auth.uid &&
        incoming().employerUid is string &&
        incoming().status == 'submitted' &&
        incoming().createdAt is string &&
        incoming().createdAtServer == request.time &&
        applicationId == incoming().jobId + '__' + request.auth.uid &&
        applicantOwnsCandidate(incoming()) &&
        applicationJobExists(incoming()) &&
        applicationJob(incoming()).status != 'closed' &&
        applicationJob(incoming()).keys().hasAll(['userId']) &&
        applicationJob(incoming()).userId == incoming().employerUid &&
        incoming().employerUid != request.auth.uid;

      allow get, list: if isAdmin() ||
        (isSignedIn() && (
          existing().applicantUid == request.auth.uid ||
          existing().employerUid == request.auth.uid
        ));

      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          existing().applicantUid == request.auth.uid &&
          incoming().applicantUid == existing().applicantUid &&
          incoming().employerUid == existing().employerUid &&
          incoming().jobId == existing().jobId &&
          incoming().candidateId == existing().candidateId &&
          incoming().status == 'withdrawn' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedAtServer']) &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time
        ) ||
        (
          isSignedIn() &&
          existing().employerUid == request.auth.uid &&
          incoming().applicantUid == existing().applicantUid &&
          incoming().employerUid == existing().employerUid &&
          incoming().jobId == existing().jobId &&
          incoming().candidateId == existing().candidateId &&
          (incoming().status == 'viewed' || incoming().status == 'shortlisted' || incoming().status == 'rejected') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedAtServer']) &&
          incoming().updatedAt is string &&
          incoming().updatedAtServer == request.time
        );

      allow delete: if false;
    }

    match /candidates/{candidateId} {
      allow get: if
        publicCandidateReadable(existing()) ||
        ownsCandidate(candidateId) ||
        isAdmin() ||
        verifiedPhoneOwnsCandidateContact(candidateId) ||
        (
          hasVerifiedSaudiPhone() &&
          existing().keys().hasAll(['phoneE164']) &&
          authOwnsPhone(existing().phoneE164)
        );

      allow list: if
        publicCandidateReadable(existing()) ||
        isAdmin() ||
        (
          hasVerifiedSaudiPhone() &&
          existing().keys().hasAll(['phoneE164']) &&
          authOwnsPhone(existing().phoneE164)
        );

      allow create: if isValidId(candidateId) &&
        incoming().schemaVersion == 2 &&
        incoming().keys().hasAll([
          'fullName', 'profession', 'city', 'iqamaStatus', 'bio',
          'phoneVerified', 'isHidden', 'allowContact', 'schemaVersion'
        ]) &&
        !incoming().keys().hasAny(['phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId']) &&
        incoming().fullName is string && incoming().fullName.size() > 0 && incoming().fullName.size() <= 100 &&
        incoming().profession is string && incoming().profession.size() <= 100 &&
        incoming().city is string && incoming().city.size() <= 50 &&
        incoming().iqamaStatus is string && incoming().iqamaStatus.size() <= 80 &&
        incoming().bio is string && incoming().bio.size() <= 2000 &&
        (!incoming().keys().hasAny(['hobbies']) || (incoming().hobbies is list && incoming().hobbies.size() <= 12)) &&
        (!incoming().keys().hasAny(['noExperience']) || incoming().noExperience is bool) &&
        incoming().phoneVerified is bool &&
        incoming().isHidden is bool &&
        incoming().allowContact is bool &&
        existsAfter(/databases/$(database)/documents/candidateContacts/$(candidateId)) &&
        getAfter(/databases/$(database)/documents/candidateContacts/$(candidateId)).data.phoneVerified == incoming().phoneVerified &&
        verifiedPublicStateMatchesContact(candidateId, incoming());

      allow update: if isValidId(candidateId) && (
        isAdmin() ||
        (
          (ownsCandidate(candidateId) || ownsCandidateAfter(candidateId)) &&
          incoming().schemaVersion == 2 &&
          !incoming().keys().hasAny(['phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId']) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'profession', 'city', 'yemeniGovernorate',
            'iqamaStatus', 'experienceYears', 'educationLevel', 'skills',
            'bio', 'hasDriverLicense', 'availableImmediately',
            'availabilityNote', 'avatarUrl', 'hobbies', 'noExperience', 'isHidden', 'allowContact',
            'nationality', 'phoneVerified', 'updatedAt', 'views',
            'phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId'
          ]) &&
          (!incoming().keys().hasAny(['hobbies']) || (incoming().hobbies is list && incoming().hobbies.size() <= 12)) &&
          (!incoming().keys().hasAny(['noExperience']) || incoming().noExperience is bool) &&
          verifiedPublicStateMatchesContact(candidateId, incoming())
        ) ||
        (
          verifiedPhoneOwnsCandidateContact(candidateId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['phoneVerified', 'allowContact', 'phoneClaimRevokedAt']) &&
          incoming().phoneVerified == false &&
          incoming().allowContact == false &&
          incoming().phoneClaimRevokedAt is string
        ) ||
        (
          hasVerifiedSaudiPhone() &&
          existing().keys().hasAll(['phoneE164']) &&
          authOwnsPhone(existing().phoneE164) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId',
            'schemaVersion', 'phoneVerified', 'allowContact', 'phoneClaimRevokedAt'
          ]) &&
          !incoming().keys().hasAny(['phone', 'phoneE164', 'whatsapp', 'userEmail', 'userId']) &&
          incoming().schemaVersion == 2 &&
          incoming().phoneVerified == false &&
          incoming().allowContact == false &&
          incoming().phoneClaimRevokedAt is string
        )
      );

      allow delete: if isValidId(candidateId) &&
        (isAdmin() || ownsCandidate(candidateId));
    }

    match /candidateContacts/{candidateId} {
      allow get: if
        isAdmin() ||
        ownsCandidate(candidateId) ||
        (isSignedIn() && existing().keys().hasAny(['userId']) && existing().userId == request.auth.uid) ||
        publicContactReadable(candidateId, existing());

      // Public callers never list contacts. New owners query candidateOwners; the
      // legacy owner clause exists only to perform one-time self-migration.
      allow list: if
        isAdmin() ||
        (isSignedIn() && existing().keys().hasAny(['userId']) && existing().userId == request.auth.uid);

      allow create: if isValidId(candidateId) &&
        validContactState(incoming(), candidateId) &&
        incoming().phone.size() > 0 &&
        existsAfter(/databases/$(database)/documents/candidates/$(candidateId)) &&
        getAfter(/databases/$(database)/documents/candidates/$(candidateId)).data.schemaVersion == 2 &&
        getAfter(/databases/$(database)/documents/candidates/$(candidateId)).data.phoneVerified == incoming().phoneVerified &&
        verifiedPublicStateMatchesContact(candidateId, getAfter(/databases/$(database)/documents/candidates/$(candidateId)).data);

      allow update: if isValidId(candidateId) && (
        isAdmin() ||
        (
          (ownsCandidate(candidateId) || ownsCandidateAfter(candidateId)) &&
          validContactState(incoming(), candidateId)
        ) ||
        (
          isSignedIn() &&
          existing().keys().hasAny(['userId']) &&
          existing().userId == request.auth.uid &&
          !incoming().keys().hasAny(['userId', 'phoneE164']) &&
          incoming().schemaVersion == 3 &&
          ownsCandidateAfter(candidateId) &&
          validContactState(incoming(), candidateId)
        ) ||
        (
          verifiedPhoneOwnsCandidateContact(candidateId) &&
          validContactState(incoming(), candidateId) &&
          incoming().phone == '' &&
          incoming().whatsapp == '' &&
          incoming().phoneVerified == false &&
          incoming().phoneClaimRevokedAt is string &&
          existsAfter(/databases/$(database)/documents/candidates/$(candidateId)) &&
          getAfter(/databases/$(database)/documents/candidates/$(candidateId)).data.phoneVerified == false &&
          getAfter(/databases/$(database)/documents/candidates/$(candidateId)).data.allowContact == false
        )
      );

      allow delete: if isValidId(candidateId) &&
        (isAdmin() || ownsCandidate(candidateId));
    }

    match /candidateOwners/{candidateId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (hasVerifiedSaudiPhone() && existing().phoneE164 == request.auth.token.phone_number);

      allow create: if isValidId(candidateId) &&
        isSignedIn() &&
        incoming().keys().hasOnly(['candidateId', 'userId', 'phoneE164', 'phoneVerified', 'schemaVersion', 'phoneClaimRevokedAt']) &&
        incoming().candidateId == candidateId &&
        incoming().userId == request.auth.uid &&
        incoming().schemaVersion == 1 &&
        incoming().phoneE164 is string &&
        incoming().phoneE164.matches('^\\+9665[0-9]{8}$') &&
        incoming().phoneVerified is bool &&
        (incoming().phoneVerified == false || authOwnsPhone(incoming().phoneE164)) &&
        existsAfter(/databases/$(database)/documents/candidates/$(candidateId));

      allow update: if isValidId(candidateId) && (
        isAdmin() ||
        (
          isSignedIn() && existing().userId == request.auth.uid &&
          incoming().candidateId == existing().candidateId &&
          incoming().userId == existing().userId &&
          incoming().schemaVersion == 1 &&
          incoming().phoneE164 is string &&
          (incoming().phoneE164 == '' || incoming().phoneE164.matches('^\\+9665[0-9]{8}$')) &&
          incoming().phoneVerified is bool &&
          (incoming().phoneVerified == false || authOwnsPhone(incoming().phoneE164)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['phoneE164', 'phoneVerified', 'phoneClaimRevokedAt'])
        ) ||
        (
          hasVerifiedSaudiPhone() &&
          authOwnsPhone(existing().phoneE164) &&
          incoming().candidateId == existing().candidateId &&
          incoming().userId == existing().userId &&
          incoming().schemaVersion == existing().schemaVersion &&
          incoming().phoneE164 == '' &&
          incoming().phoneVerified == false &&
          incoming().phoneClaimRevokedAt is string &&
          incoming().diff(existing()).affectedKeys().hasOnly(['phoneE164', 'phoneVerified', 'phoneClaimRevokedAt'])
        )
      );

      allow delete: if isValidId(candidateId) &&
        (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }
  }
}
