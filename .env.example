# Gemini (optional). Because this is a Vite client app, any VITE_ key is visible
# to the browser. Use a Google API key restricted to the production domain/API.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Google production configuration. Keep blank until real IDs are available.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_GTAG_ID=
VITE_GOOGLE_CMP_ENABLED=false
VITE_SEARCH_CONSOLE_API_ENDPOINT=

# Optional public canonical origin. Defaults to the current Render URL in code.
VITE_PUBLIC_SITE_URL=https://nextjob1-1.onrender.com
