# AI cover-letter generation must not receive a Gemini API key in the browser.
# Leave blank to use the built-in local fallback, or point this at a trusted
# HTTPS server-side endpoint that keeps GEMINI_API_KEY outside the Vite bundle.
VITE_GEMINI_PROXY_ENDPOINT=

# Google production configuration. Keep blank until real IDs are available.
# AdSense remains disabled until the complete Google production status is READY.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_JOBS=
VITE_GTAG_ID=
VITE_GOOGLE_CMP_ENABLED=false
VITE_SEARCH_CONSOLE_API_ENDPOINT=

# Optional public canonical origin. Defaults to the current Render URL in code.
VITE_PUBLIC_SITE_URL=https://nextjob1-1.onrender.com
