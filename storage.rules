rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /candidate-avatars/{uid}/{fileName} {
      // Candidate photos are public profile assets; writes are owner-only.
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 600 * 1024 &&
        request.resource.contentType.matches('image/(webp|jpeg|png)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
