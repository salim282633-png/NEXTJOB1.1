rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // New avatar paths do not expose the Firebase UID in the public download URL.
    // SDK metadata/read access remains owner-only; saved Firebase download-token URLs
    // are used by public profile <img> elements.
    match /candidate-avatars-v2/{candidateId}/{fileName} {
      allow read: if request.auth != null &&
        resource.metadata.ownerUid == request.auth.uid;

      allow create: if request.auth != null &&
        request.resource.metadata.ownerUid == request.auth.uid &&
        request.resource.metadata.candidateId == candidateId &&
        request.resource.size < 600 * 1024 &&
        request.resource.contentType.matches('image/(webp|jpeg|png)');

      allow update: if request.auth != null &&
        resource.metadata.ownerUid == request.auth.uid &&
        request.resource.metadata.ownerUid == resource.metadata.ownerUid &&
        request.resource.metadata.candidateId == candidateId &&
        request.resource.size < 600 * 1024 &&
        request.resource.contentType.matches('image/(webp|jpeg|png)');

      allow delete: if request.auth != null &&
        resource.metadata.ownerUid == request.auth.uid;
    }

    // Legacy URLs keep working until owners replace their avatar. New uploads never
    // use this UID-bearing path.
    match /candidate-avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 600 * 1024 &&
        request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
